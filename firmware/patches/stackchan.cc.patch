+    // Renders the latest recognized user speech as a topmost bottom-aligned
+    // subtitle strip so users can see the device heard them (the full-screen
+    // avatar hides the stock chat UI). Called from Application's stt handler
+    // via the Board hook; runs in the same locked schedule context as
+    // Display::SetChatMessage, so DisplayLockGuard here matches that path.
+    virtual void OnUserSttText(const char* text) override {
+        if (text == nullptr || display_ == nullptr) return;
+        DisplayLockGuard lock(display_);
+        if (stt_subtitle_label_ == nullptr || !lv_obj_is_valid(stt_subtitle_label_)) {
+            lv_obj_t* screen = lv_screen_active();
+            if (screen == nullptr) return;
+            stt_subtitle_label_ = lv_label_create(screen);
+            if (stt_subtitle_label_ == nullptr) return;
+            lv_obj_set_width(stt_subtitle_label_, 304);
