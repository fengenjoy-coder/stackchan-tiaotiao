+        }
+        lv_label_set_text(stt_subtitle_label_, text);
+        lv_obj_clear_flag(stt_subtitle_label_, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_move_foreground(stt_subtitle_label_);
+    }
