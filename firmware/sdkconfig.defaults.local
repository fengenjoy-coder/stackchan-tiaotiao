CONFIG_STACKCHAN_TOUCH_PTT=y
CONFIG_USE_AFE_WAKE_WORD=y
# CONFIG_USE_CUSTOM_WAKE_WORD is not set
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
