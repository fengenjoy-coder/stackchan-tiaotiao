CONFIG_FORCE_DEFAULT_WEBSOCKET_URL=y
CONFIG_DEFAULT_WEBSOCKET_URL="ws://192.168.9.243:8000/xiaozhi/v1/"
CONFIG_DEFAULT_WEBSOCKET_FALLBACK_URL=""
